@page
@model ProgramsModel
@{
    ViewData["Title"] = "Projekty edukacyjne";
}

<section class="subpage-hero programs-page-hero">
    <div class="container">
        <span class="eyebrow">Repozytorium projektów edukacyjnych</span>
        <h1>Podstawówka i szkoła średnia w jednym katalogu.</h1>
        <p>
            Wybierz poziom edukacji albo przejdź z osi czasu na stronie głównej.
            Jeśli wejdziesz z wybranego programu, pokażemy go na początku listy w odpowiedniej sekcji.
        </p>
    </div>
</section>

<section class="section-spacing pt-0">
    <div class="container">
        <script id="programs-repository-data" type="application/json">
            @Html.Raw(Json.Serialize(Model.Programs))
        </script>

        <div id="programs-repository-root"
             data-initial-level="@Model.InitialLevelFilter"
             data-selected-program-id="@Model.SelectedProgramId"></div>
    </div>
</section>
