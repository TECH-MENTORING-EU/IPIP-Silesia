@page
@{
    ViewData["Title"] = "Networking";
}

<section class="subpage-hero">
    <div class="container">
        <span class="eyebrow">Networking i poznawanie ludzi</span>
        <h1>Społeczność, która skraca dystans między szkołą a pierwszą pracą.</h1>
        <p>
            Tutaj można rozwijać wydarzenia lokalne, klub absolwenta, spotkania z pracodawcami,
            mentoring oraz formaty wspierające młode osoby w wejściu na rynek pracy.
        </p>
    </div>
</section>

<section class="section-spacing pt-0">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <article class="info-card h-100">
                    <p class="card-kicker">Format #1</p>
                    <h2 class="h4">Meetupy lokalne</h2>
                    <p>Spotkania po szkole lub po pracy z absolwentami, liderami zmian i mentorami z regionu.</p>
                    <ul class="offer-list">
                        <li>krótkie rozmowy o realiach pracy</li>
                        <li>sesje pytań i odpowiedzi</li>
                        <li>poznawanie dostępnych ścieżek startowych</li>
                    </ul>
                </article>
            </div>
            <div class="col-lg-4">
                <article class="info-card h-100">
                    <p class="card-kicker">Format #2</p>
                    <h2 class="h4">Mentoring zadaniowy</h2>
                    <p>Krótka współpraca 1:1 lub w małych grupach, skupiona na konkretnym celu z pierwszych 30 dni po maturze.</p>
                    <ul class="offer-list">
                        <li>ułożenie planu działania</li>
                        <li>feedback do CV i profilu</li>
                        <li>wybór programu lub oferty</li>
                    </ul>
                </article>
            </div>
            <div class="col-lg-4">
                <article class="info-card h-100">
                    <p class="card-kicker">Format #3</p>
                    <h2 class="h4">Wydarzenia z pracodawcami</h2>
                    <p>Kamery, hale, magazyny i zakłady pracy można przybliżyć przez prezentacje, wizyty studyjne i mini-zadania.</p>
                    <ul class="offer-list">
                        <li>dni otwarte i job shadowing</li>
                        <li>rozmowy z rekruterami</li>
                        <li>spotkania „z projektu do pracy”</li>
                    </ul>
                </article>
            </div>
        </div>
    </div>
</section>
