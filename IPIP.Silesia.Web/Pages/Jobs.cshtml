@page
@{
    ViewData["Title"] = "Praca";
}

<section class="subpage-hero">
    <div class="container">
        <span class="eyebrow">Praca</span>
        <h1>Fizyczne oferty pracy i prosty model przejścia z projektu do zatrudnienia.</h1>
        <p>
            Sekcja ofert może stać się tablicą lokalnych ogłoszeń z rolami startowymi, wymaganiami, tempem wdrożenia i informacją,
            które projekty edukacyjne najlepiej przygotowują do danej pracy.
        </p>
    </div>
</section>

<section class="section-spacing pt-0">
    <div class="container">
        <div class="row g-4">
            <div class="col-xl-4">
                <article class="info-card h-100">
                    <p class="card-kicker">Oferta #1</p>
                    <h2 class="h4">Pomocnik magazynowy</h2>
                    <p>Praca zmianowa, kompletacja i przygotowanie wysyłek w centrum logistycznym.</p>
                    <ul class="offer-list">
                        <li>wdrożenie: 5 dni</li>
                        <li>wymagane: punktualność i sprawność organizacyjna</li>
                        <li>powiązany program: Start na magazynie</li>
                    </ul>
                </article>
            </div>
            <div class="col-xl-4">
                <article class="info-card h-100">
                    <p class="card-kicker">Oferta #2</p>
                    <h2 class="h4">Operator wsparcia produkcji</h2>
                    <p>Proste zadania produkcyjne z naciskiem na jakość i współpracę z brygadzistą.</p>
                    <ul class="offer-list">
                        <li>wdrożenie: 2 tygodnie</li>
                        <li>wymagane: dokładność i gotowość do pracy na zmianie</li>
                        <li>powiązany program: Produkcja bez stresu</li>
                    </ul>
                </article>
            </div>
            <div class="col-xl-4">
                <article class="info-card h-100">
                    <p class="card-kicker">Oferta #3</p>
                    <h2 class="h4">Pracownik pomocniczy w logistyce</h2>
                    <p>Rola startowa dla osób po krótkim projekcie praktycznym lub programie wdrożeniowym.</p>
                    <ul class="offer-list">
                        <li>wdrożenie: 7 dni</li>
                        <li>wymagane: komunikacja, obecność, gotowość do uczenia się</li>
                        <li>powiązany program: Logistyka pierwszego kroku</li>
                    </ul>
                </article>
            </div>
        </div>
    </div>
</section>
