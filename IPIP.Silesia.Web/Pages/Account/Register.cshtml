@page
@model IPIP.Silesia.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Rejestracja";
}

<section class="section-spacing">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="info-card">
                    <h1 class="h3">Załóż konto</h1>
                    <form method="post" class="mt-4">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label"></label>
                            <input asp-for="Input.Email" class="form-control" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label"></label>
                            <input asp-for="Input.Password" class="form-control" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.ProfileType" class="form-label"></label>
                            <select asp-for="Input.ProfileType" class="form-select">
                                <option value="Rodzic">Rodzic</option>
                                <option value="Uczen">Uczeń</option>
                            </select>
                            <span asp-validation-for="Input.ProfileType" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-accent w-100">Utwórz konto</button>
                    </form>
                    <p class="mt-3 mb-0">Masz już konto? <a asp-page="/Account/Login">Zaloguj się</a></p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
